# GameConnect configuration example.
#
# Reference template for the environment variables GameConnect reads. Set them
# in your shell, service manager, or deployment platform; Spring Boot does not
# load a .env file by itself, so a copied file only takes effect when something
# exports it first. The variables up to and including COOKIE_SECURE configure
# the backend; the last section configures the Next.js frontend.
#
# docker-compose.yml is self-contained and does NOT read this file: it starts
# the local PostgreSQL with the development credentials
# db/user/password = "gameconnect" on port 5430, which the backend defaults
# already match.
#
# Never commit a filled-in .env file or real credentials.

# --- Database (Spring datasource) -----------------------------------------
# Local development default: jdbc:postgresql://localhost:5430/gameconnect
DB_URL=jdbc:postgresql://localhost:5430/gameconnect
# Local development default (docker-compose.yml): gameconnect
DB_USER=replace-with-your-db-user
# Local development default (docker-compose.yml): gameconnect
DB_PASSWORD=replace-with-your-db-password

# --- Server ---------------------------------------------------------------
# HTTP port the backend listens on. Local development default: 8080
PORT=8080

# --- JWT / session --------------------------------------------------------
# MANDATORY IN PRODUCTION. Use a unique, randomly generated string of at least
# 32 bytes (HS256). The built-in default in application.yml is a public
# development value and must never be used in production.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Lifetime of the JWT and of the auth cookie, in minutes. Default: 60
JWT_EXPIRATION_MINUTES=60

# --- Game completion ------------------------------------------------------
# Grace period after a game's end time before it auto-completes. Accepts an
# ISO-8601 duration (e.g. 6h, 30m, 90s). Attendance stays open until the
# window closes. Default: 6h
GAME_COMPLETION_GRACE=6h

# --- Cookies --------------------------------------------------------------
# Set to true when the app is served over HTTPS so the auth cookie is marked
# Secure. Keep false only for plain-HTTP local development. Default: false
COOKIE_SECURE=false

# --- Frontend (Next.js) ---------------------------------------------------
# Build/dev-time base URL that the Next.js server rewrites /api/* to. Set in
# frontend/.env.local or the shell, not in the backend's environment.
# Local development default: http://localhost:8080/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
